# Canonical site URL — no trailing slash. Everything (canonical tags, OG
# image URLs, RSS, sitemap) is built from this. Swap it for a real domain
# later; the .vercel.app URL keeps working as long as it stays deployed.
SITE_URL=http://localhost:4321

# Upstash Redis (REST API, not the TCP one) — view counts, reactions, the
# guestbook list, and rate limiting on the contact form and guestbook.
# https://console.upstash.com -> create a Redis database -> REST API section.
# Every feature that uses this fails open/silent when it's unset — see README.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — sends the contact form to your inbox.
# https://resend.com -> API Keys. CONTACT_FROM_EMAIL must be on a domain
# you've verified with Resend (their sandbox domain works for testing).
RESEND_API_KEY=
CONTACT_EMAIL=you@example.com
CONTACT_FROM_EMAIL=contact@yourdomain.com

# Cusdis — comments on articles and Assembly pieces.
# https://cusdis.com -> create a project -> App ID. PUBLIC_ because it's
# embedded in client-side script; it's not a secret. Leave PUBLIC_CUSDIS_HOST
# unset to use the default https://cusdis.com, or point it at a self-hosted
# instance.
PUBLIC_CUSDIS_APP_ID=
PUBLIC_CUSDIS_HOST=

# Buttondown — newsletter signup. https://buttondown.com -> your username
# is the last part of your buttondown.com/<username> URL. Also not a
# secret — the embed form posts directly to Buttondown from the browser.
PUBLIC_BUTTONDOWN_USERNAME=

# Guestbook moderation. Any long random string — generate one with
# `openssl rand -hex 32`. Visiting /admin/guestbook?token=<this value>
# is the only way to approve or reject pending entries.
GUESTBOOK_ADMIN_TOKEN=
