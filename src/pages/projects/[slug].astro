---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import PageHeader from "../../components/PageHeader.astro";

export async function getStaticPaths() {
  const projects = await getCollection(
    "projects",
    (entry: CollectionEntry<"projects">) => import.meta.env.DEV || !entry.data.draft,
  );
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"projects">;
}

const { entry } = Astro.props;
const { title, description, role, stack, outcome, repoUrl, demoUrl } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={description}>
  <Header />

  <main class="page">
    <PageHeader title={title} lede={description} size="md">
      <a href="/projects" class="back-link" slot="top">← All projects</a>

      <dl class="project-meta">
        <div>
          <dt>Role</dt>
          <dd>{role}</dd>
        </div>
        <div>
          <dt>Outcome</dt>
          <dd>{outcome}</dd>
        </div>
      </dl>

      <ul class="project-stack">
        {stack.map((tech) => <li>{tech}</li>)}
      </ul>

      {
        (repoUrl || demoUrl) && (
          <div class="project-links">
            {demoUrl && (
              <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                Live demo ↗
              </a>
            )}
            {repoUrl && (
              <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
                Repository ↗
              </a>
            )}
          </div>
        )
      }
    </PageHeader>

    <div class="page-body-narrow">
      <div class="prose">
        <Content />
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .back-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-editorial);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .project-meta {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    max-width: 40rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .project-meta dt {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .project-meta dd {
    margin-top: 0.25rem;
  }

  .project-stack {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-stack li {
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background-color: var(--color-accent-soft);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text);
  }

  .project-links {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
