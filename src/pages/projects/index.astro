---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SocialIcon from "../../components/SocialIcon.astro";
import { SITE } from "../../config/site";
import { getCollection, type CollectionEntry } from "astro:content";

function isPublished(entry: CollectionEntry<"projects">): boolean {
  return import.meta.env.DEV || !entry.data.draft;
}

const projects = (await getCollection("projects", isPublished)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Projects" description="Work and side projects — the problem, the role, and what I'd do differently.">
  <Header />

  <main class="page">
    <PageHeader
      eyebrow="Work"
      title="Projects"
      lede="Case studies, not a logo wall — the problem, my role, and what I'd do differently."
    />

    <div class="page-body">
      {
        projects.length > 0 ? (
          <div class="grid gap-6 sm:grid-cols-2">
            {projects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        ) : (
          <div class="panel empty-panel">
            <p class="eyebrow">In progress</p>
            <p class="empty-title">Case studies are on the way.</p>
            <p class="empty-text">In the meantime, my code and experiments live on GitHub.</p>
            <a href={SITE.social.github} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              <SocialIcon name="github" /> View GitHub
            </a>
          </div>
        )
      }
    </div>
  </main>
</BaseLayout>

<style>
  .empty-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 2rem 1.5rem;
  }

  @media (min-width: 640px) {
    .empty-panel {
      padding: 2.5rem 3rem;
    }
  }

  .empty-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 1;
    color: var(--color-text);
  }

  .empty-text {
    margin-bottom: 0.75rem;
    font-family: var(--font-sans);
    color: var(--color-text-muted);
  }
</style>
