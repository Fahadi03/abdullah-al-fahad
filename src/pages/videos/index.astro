---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import VideoCard from "../../components/VideoCard.astro";
import { getPublishedVideos, type VideoEntry } from "../../lib/videos";

const videos = await getPublishedVideos();

const topics = Array.from(new Set(videos.map((video) => video.data.topic))).sort();

const playlists = new Map<string, VideoEntry[]>();
const ungrouped: VideoEntry[] = [];
for (const video of videos) {
  if (video.data.playlist) {
    const group = playlists.get(video.data.playlist) ?? [];
    group.push(video);
    playlists.set(video.data.playlist, group);
  } else {
    ungrouped.push(video);
  }
}
---

<BaseLayout title="Videos" description="Talks, walkthroughs and screencasts, filterable by topic.">
  <Header />

  <main class="mx-auto max-w-5xl px-6 py-12 sm:px-10 sm:py-16">
    <h1 class="font-serif text-4xl leading-tight text-balance">Videos</h1>
    <p class="mt-3 max-w-prose font-serif text-lg text-text-muted">Talks, walkthroughs and screencasts.</p>

    {
      videos.length === 0 ? (
        <p class="empty-state">No videos yet — check back soon.</p>
      ) : (
        <>
          {
            topics.length > 1 && (
              <div class="filter-group" role="group" aria-label="Filter by topic" data-topic-filter>
                <button type="button" class="chip chip-active" data-topic-value="all">
                  All
                </button>
                {topics.map((topic) => (
                  <button type="button" class="chip" data-topic-value={topic}>
                    {topic}
                  </button>
                ))}
              </div>
            )
          }

          <div data-video-list>
            {
              ungrouped.length > 0 && (
                <div class="video-grid">
                  {ungrouped.map((video) => (
                    <VideoCard video={video} />
                  ))}
                </div>
              )
            }

            {
              Array.from(playlists.entries()).map(([playlist, items]) => (
                <section class="playlist-section">
                  <h2 class="playlist-title">{playlist}</h2>
                  <div class="video-grid">
                    {items.map((video) => (
                      <VideoCard video={video} />
                    ))}
                  </div>
                </section>
              ))
            }
          </div>

          <p class="empty-state" data-empty-state hidden>
            No videos match this topic.
          </p>
        </>
      )
    }
  </main>
</BaseLayout>

<style>
  .empty-state {
    margin-top: 3rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .filter-group {
    margin-top: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    padding: 0.375rem 0.75rem;
    min-height: 32px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    transition:
      color var(--duration-fast) var(--ease-editorial),
      border-color var(--duration-fast) var(--ease-editorial),
      background-color var(--duration-fast) var(--ease-editorial);
  }

  .chip:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  .chip-active {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .video-grid {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .video-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .playlist-section + .playlist-section {
    margin-top: 3rem;
  }

  .playlist-title {
    margin-top: 3rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>("[data-video-list]");
  const cards = Array.from(list?.querySelectorAll<HTMLElement>("[data-topic]") ?? []);
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");

  document.querySelectorAll<HTMLButtonElement>("[data-topic-value]").forEach((button) => {
    button.addEventListener("click", () => {
      document
        .querySelectorAll<HTMLButtonElement>("[data-topic-value]")
        .forEach((b) => b.classList.toggle("chip-active", b === button));

      const topic = button.dataset.topicValue ?? "all";
      let visible = 0;
      for (const card of cards) {
        const matches = topic === "all" || card.dataset.topic === topic;
        card.style.display = matches ? "" : "none";
        if (matches) visible++;
      }

      // A playlist heading with every card in it hidden reads as a bug — hide the section too.
      document.querySelectorAll<HTMLElement>(".playlist-section").forEach((section) => {
        const anyVisible = Array.from(section.querySelectorAll<HTMLElement>("[data-topic]")).some(
          (card) => card.style.display !== "none",
        );
        section.style.display = anyVisible ? "" : "none";
      });

      emptyState?.toggleAttribute("hidden", visible !== 0);
    });
  });
</script>
