---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PageHeader from "../components/PageHeader.astro";
import { formatDate } from "../lib/numerals";

const updated = new Date("2026-08-07");
---

<BaseLayout title="Now" description="What I'm working on this month.">
  <Header />

  <main class="page">
    <PageHeader
      eyebrow={`Updated ${formatDate(updated, "en")}`}
      title="Now"
      lede="What I'm focused on this month."
    />

    <div class="page-body-narrow">
      <ul class="now-list">
        <li>
          Building this site, one section at a time — writings, videos and Assembly of Ideas are live; projects,
          comments and the rest of the dynamic layer are next.
        </li>
        <li>Writing the next episode of the গবেষণা ও মেশিন লার্নিং series on /writings.</li>
        <li>Publishing occasional pieces on Assembly of Ideas — তত্ত্ব সভা.</li>
      </ul>

      <p class="footnote">A /now page — a short, dated note on the current focus, not a running blog.</p>
    </div>
  </main>
</BaseLayout>

<style>
  .now-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-family: var(--font-sans);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .now-list li {
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background-color: var(--color-panel);
  }

  .footnote {
    margin-top: 2.5rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
