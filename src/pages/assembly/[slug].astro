---
import { getCollection, render, type CollectionEntry } from "astro:content";
import AssemblyLayout from "../../layouts/AssemblyLayout.astro";
import LanguageChip from "../../components/LanguageChip.astro";
import ShareRow from "../../components/ShareRow.astro";
import ViewCount from "../../components/ViewCount.astro";
import ReactionButton from "../../components/ReactionButton.astro";
import CommentSection from "../../components/CommentSection.astro";
import { formatDate } from "../../lib/numerals";
import { SITE } from "../../config/site";

export async function getStaticPaths() {
  const pieces = await getCollection(
    "assembly",
    (entry: CollectionEntry<"assembly">) => import.meta.env.DEV || !entry.data.draft,
  );
  return pieces.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"assembly">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const canonicalUrl = new URL(`${SITE.assemblyBase}/${entry.id}`, SITE.url).toString();
---

<AssemblyLayout title={entry.data.title} description={entry.data.description} lang={entry.data.lang}>
  <main class="mx-auto max-w-3xl px-6 py-12 sm:px-10 sm:py-16">
    <a href={SITE.assemblyBase} class="back-link">← Assembly of Ideas</a>

    <header class="mt-6 mb-10">
      <LanguageChip lang={entry.data.lang} />
      <h1 class="piece-title" lang={entry.data.lang}>{entry.data.title}</h1>
      <p class="piece-description" lang={entry.data.lang}>{entry.data.description}</p>
      <div class="piece-date-row">
        <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate, entry.data.lang)}</time>
        <ViewCount viewKey={`views:assembly:${entry.id}`} lang={entry.data.lang} server:defer>
          <Fragment slot="fallback" />
        </ViewCount>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <ReactionButton slug={entry.id} namespace="assembly" lang={entry.data.lang} />
        <ShareRow url={canonicalUrl} title={entry.data.title} />
      </div>
    </header>

    <div class="prose" lang={entry.data.lang}>
      <Content />
    </div>

    <CommentSection pageId={`assembly:${entry.id}`} pageUrl={canonicalUrl} pageTitle={entry.data.title} />
  </main>
</AssemblyLayout>

<style>
  .back-link {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) var(--ease-editorial);
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .piece-title {
    margin-top: 1rem;
    font-family: var(--font-display-bn);
    font-size: var(--text-4xl);
    line-height: 1.3;
    text-wrap: balance;
  }

  .piece-description {
    margin-top: 1rem;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .piece-date-row {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
