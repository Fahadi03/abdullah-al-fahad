---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PageHeader from "../components/PageHeader.astro";
import { SITE } from "../config/site";

const links = [
  { href: "/", label: "Home" },
  { href: "/writings", label: "Writings" },
  { href: "/projects", label: "Projects" },
  { href: SITE.assemblyBase, label: "Assembly of Ideas" },
];
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <Header />

  <main class="page">
    <PageHeader
      eyebrow="404"
      title="Page not found"
      lede="The link might be old, or mistyped. Try one of these instead."
    >
      <p class="lede-bn" lang="bn">লিঙ্কটা হয়তো পুরনো, অথবা ভুল টাইপ হয়েছে। এর বদলে এগুলো দেখতে পারেন।</p>
      <ul class="links">
        {
          links.map((link, index) => (
            <li>
              <a href={link.href} class:list={["btn", index === 0 ? "btn-primary" : "btn-outline"]}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </PageHeader>
  </main>
</BaseLayout>

<style>
  .lede-bn {
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    color: var(--color-text-muted);
  }

  .links {
    margin-top: 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
