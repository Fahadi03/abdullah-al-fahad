---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import ArticleCard from "../components/ArticleCard.astro";
import VideoCard from "../components/VideoCard.astro";
import { getPublishedWritings, getAllSeries, resolveSeries } from "../lib/writings";
import { getPublishedVideos } from "../lib/videos";
import { estimateReadingMinutes } from "../lib/reading-time";
import { formatNumber } from "../lib/numerals";
import { SITE } from "../config/site";

const writings = await getPublishedWritings();
const allSeries = await getAllSeries();
const videos = await getPublishedVideos();
const assemblyPieces = (
  await getCollection("assembly", (entry) => import.meta.env.DEV || !entry.data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestWriting = writings[0];
const latestWritingSeries = latestWriting ? await resolveSeries(latestWriting) : undefined;
const latestVideo = videos[0];
const latestPiece = assemblyPieces[0];

// "Recent" mixes articles and videos, newest first.
const recentWritings = await Promise.all(
  writings.map(async (entry) => ({
    kind: "writing" as const,
    date: entry.data.pubDate,
    entry,
    series: await resolveSeries(entry),
    readingMinutes: estimateReadingMinutes(entry.body ?? "", entry.data.lang),
  })),
);
const recentVideos = videos.map((video) => ({ kind: "video" as const, date: video.data.pubDate, video }));
const recent = [...recentWritings, ...recentVideos].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 4);
---

<BaseLayout title="Home" description={SITE.tagline}>
  <Header />

  <main class="mx-auto max-w-5xl px-6 sm:px-10">
    <section class="py-20 sm:py-28">
      <h1 class="max-w-2xl font-serif text-4xl leading-tight text-balance sm:text-5xl">{SITE.name}</h1>
      <p class="mt-4 max-w-xl font-serif text-lg text-text-muted">
        I write about research and machine learning, build software, and run Assembly of Ideas — a home
        for Bangla literature and history.
      </p>
      <p class="mt-8 font-sans text-xs text-text-muted">
        {formatNumber(writings.length, "en")} article{writings.length === 1 ? "" : "s"} · {
          formatNumber(allSeries.length, "en")
        } series
        {
          videos.length > 0 && (
            <>
              {" "}
              · {formatNumber(videos.length, "en")} video{videos.length === 1 ? "" : "s"}
            </>
          )
        }
      </p>
    </section>

    <section class="entry-grid border-t border-border py-16">
      <a href="/writings" class="entry-card">
        <span class="entry-label">Writings</span>
        {
          latestWriting ? (
            <>
              <h2 class="entry-title" lang={latestWriting.data.lang}>
                {latestWriting.data.title}
              </h2>
              <p class="entry-meta">
                Latest{latestWritingSeries ? ` · ${latestWritingSeries.data.title}` : ""}
              </p>
            </>
          ) : (
            <p class="entry-meta">Coming soon</p>
          )
        }
      </a>

      {
        latestPiece ? (
          <a href={SITE.assemblyBase} class="entry-card entry-card-assembly">
            <span class="entry-label">Assembly of Ideas — তত্ত্ব সভা</span>
            <h2 class="entry-title" lang={latestPiece.data.lang}>
              {latestPiece.data.title}
            </h2>
            <p class="entry-meta">Latest</p>
          </a>
        ) : (
          <div class="entry-card entry-card-assembly" aria-disabled="true">
            <span class="entry-label">Assembly of Ideas — তত্ত্ব সভা</span>
            <p class="entry-meta">Coming soon</p>
          </div>
        )
      }

      {
        latestVideo ? (
          <a href="/videos" class="entry-card">
            <span class="entry-label">Videos</span>
            <h2 class="entry-title">{latestVideo.data.title}</h2>
            <p class="entry-meta">Latest</p>
          </a>
        ) : (
          <div class="entry-card" aria-disabled="true">
            <span class="entry-label">Videos</span>
            <p class="entry-meta">Coming soon</p>
          </div>
        )
      }
    </section>

    {
      recent.length > 0 && (
        <section class="border-t border-border py-16">
          <h2 class="mb-8 font-sans text-sm font-medium uppercase tracking-wide text-text-muted">Recent</h2>
          <div class="grid gap-6 sm:grid-cols-2">
            {recent.map((item) =>
              item.kind === "writing" ? (
                <ArticleCard entry={item.entry} series={item.series} readingMinutes={item.readingMinutes} />
              ) : (
                <VideoCard video={item.video} />
              ),
            )}
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .entry-grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .entry-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .entry-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem;
    min-height: 12rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition:
      border-color var(--duration-fast) var(--ease-editorial),
      background-color var(--duration-fast) var(--ease-editorial);
  }

  a.entry-card:hover {
    border-color: var(--color-accent);
    background-color: var(--color-bg-raised);
  }

  .entry-card[aria-disabled="true"] {
    color: var(--color-text-muted);
    opacity: 0.6;
  }

  .entry-card-assembly .entry-label {
    color: var(--color-assembly-accent);
  }

  .entry-label {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .entry-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.3;
    margin-top: auto;
  }

  .entry-meta {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: auto;
  }
</style>
