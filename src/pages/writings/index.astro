---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getPublishedWritings, getAllSeries, resolveSeries } from "../../lib/writings";
import { estimateReadingMinutes } from "../../lib/reading-time";

const writings = await getPublishedWritings();
const allSeries = await getAllSeries();

const cards = await Promise.all(
  writings.map(async (entry) => ({
    entry,
    series: await resolveSeries(entry),
    readingMinutes: estimateReadingMinutes(entry.body ?? "", entry.data.lang),
  })),
);

const allTags = Array.from(new Set(writings.flatMap((entry) => entry.data.tags))).sort();
---

<BaseLayout
  title="Writings"
  description="Bangla and English writing — research notes, technical writeups, and episode-style series."
>
  <Header />

  <main class="mx-auto max-w-5xl px-6 py-12 sm:px-10 sm:py-16">
    <h1 class="font-serif text-4xl leading-tight text-balance">Writings</h1>
    <p class="mt-3 max-w-prose font-serif text-lg text-text-muted">
      Bangla and English, mixed on purpose. Filter by language, tag, or series.
    </p>

    <div class="filter-bar" data-filter-bar>
      <div class="search-field">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="search-icon" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
          type="search"
          data-search-input
          placeholder="Search writings…"
          aria-label="Search writings"
          disabled
        />
      </div>

      <div class="filter-row">
        <div class="filter-group" role="group" aria-label="Filter by language">
          <button type="button" class="chip chip-active" data-filter="lang" data-value="all">All</button>
          <button type="button" class="chip" data-filter="lang" data-value="bn">বাংলা</button>
          <button type="button" class="chip" data-filter="lang" data-value="en">English</button>
        </div>

        {
          allSeries.length > 0 && (
            <div class="filter-group" role="group" aria-label="Filter by series">
              <button type="button" class="chip chip-active" data-filter="series" data-value="all">
                All series
              </button>
              {allSeries.map((series) => (
                <button type="button" class="chip" data-filter="series" data-value={series.id}>
                  {series.data.title}
                </button>
              ))}
            </div>
          )
        }

        <div class="view-toggle" role="group" aria-label="Layout">
          <button type="button" class="view-btn" data-view="grid" aria-pressed="true" aria-label="Grid view">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
              <rect x="3" y="3" width="8" height="8" rx="1"></rect>
              <rect x="13" y="3" width="8" height="8" rx="1"></rect>
              <rect x="3" y="13" width="8" height="8" rx="1"></rect>
              <rect x="13" y="13" width="8" height="8" rx="1"></rect>
            </svg>
          </button>
          <button type="button" class="view-btn" data-view="list" aria-pressed="false" aria-label="List view">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4">
              <path d="M3 6h18M3 12h18M3 18h18"></path>
            </svg>
          </button>
        </div>
      </div>

      {
        allTags.length > 0 && (
          <div class="filter-group" role="group" aria-label="Filter by tag">
            {allTags.map((tag) => (
              <button type="button" class="chip" data-filter="tag" data-value={tag}>
                {tag}
              </button>
            ))}
          </div>
        )
      }
    </div>

    <div class="writings-grid" data-writings-list>
      {
        cards.map(({ entry, series, readingMinutes }) => (
          <ArticleCard entry={entry} series={series} readingMinutes={readingMinutes} />
        ))
      }
    </div>

    <p class="empty-state" data-empty-state hidden>No writings match these filters yet.</p>
  </main>
</BaseLayout>

<style>
  .filter-bar {
    margin-top: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .search-field {
    position: relative;
    max-width: 24rem;
  }

  .search-icon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    height: 1rem;
    width: 1rem;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .search-field input {
    width: 100%;
    height: 2.75rem;
    padding-left: 2.5rem;
    padding-right: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .search-field input::placeholder {
    color: var(--color-text-muted);
  }

  .search-field input:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .search-field input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .filter-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    padding: 0.375rem 0.75rem;
    min-height: 32px;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    transition:
      color var(--duration-fast) var(--ease-editorial),
      border-color var(--duration-fast) var(--ease-editorial),
      background-color var(--duration-fast) var(--ease-editorial);
  }

  .chip:hover {
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  .chip-active {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .view-toggle {
    display: flex;
    gap: 0.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.125rem;
  }

  .view-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2rem;
    width: 2rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  .view-btn[aria-pressed="true"] {
    background-color: var(--color-bg-raised);
    color: var(--color-text);
  }

  .writings-grid {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  .writings-grid.is-grid {
    grid-template-columns: 1fr;
  }

  @media (min-width: 640px) {
    .writings-grid.is-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .writings-grid.is-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .empty-state {
    margin-top: 3rem;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>

<script>
  const VIEW_KEY = "writings-view";
  const list = document.querySelector<HTMLElement>("[data-writings-list]");
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");
  const cards = Array.from(list?.children ?? []) as HTMLElement[];

  const state = {
    lang: "all",
    series: "all",
    tags: new Set<string>(),
    // null = no search query active; otherwise the set of matching slugs.
    searchSlugs: null as Set<string> | null,
  };

  function applyFilters() {
    let visible = 0;
    for (const card of cards) {
      const slug = card.dataset.slug ?? "";
      const lang = card.dataset.lang ?? "";
      const series = card.dataset.series ?? "";
      const tags = (card.dataset.tags ?? "").split(",").filter(Boolean);

      const matches =
        (state.lang === "all" || state.lang === lang) &&
        (state.series === "all" || state.series === series) &&
        (state.tags.size === 0 || tags.some((tag) => state.tags.has(tag))) &&
        (state.searchSlugs === null || state.searchSlugs.has(slug));

      card.style.display = matches ? "" : "none";
      if (matches) visible++;
    }
    emptyState?.toggleAttribute("hidden", visible !== 0);
  }

  document.querySelectorAll<HTMLButtonElement>("[data-filter]").forEach((button) => {
    button.addEventListener("click", () => {
      const type = button.dataset.filter;
      const value = button.dataset.value ?? "";

      if (type === "tag") {
        const active = state.tags.has(value);
        active ? state.tags.delete(value) : state.tags.add(value);
        button.classList.toggle("chip-active", !active);
      } else if (type === "lang") {
        state.lang = value;
        document.querySelectorAll<HTMLButtonElement>('[data-filter="lang"]').forEach((b) => {
          b.classList.toggle("chip-active", b === button);
        });
      } else if (type === "series") {
        state.series = value;
        document.querySelectorAll<HTMLButtonElement>('[data-filter="series"]').forEach((b) => {
          b.classList.toggle("chip-active", b === button);
        });
      }

      applyFilters();
    });
  });

  function applyView(view: "grid" | "list") {
    list?.classList.toggle("is-grid", view === "grid");
    list?.classList.toggle("is-list", view === "list");
    document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.view === view));
    });
  }

  const storedView = localStorage.getItem(VIEW_KEY);
  applyView(storedView === "list" ? "list" : "grid");

  document.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((button) => {
    button.addEventListener("click", () => {
      const view = button.dataset.view === "list" ? "list" : "grid";
      applyView(view);
      localStorage.setItem(VIEW_KEY, view);
    });
  });

  // Pagefind's index is generated by a post-build CLI step (see package.json),
  // so it only exists for a production build — never in `astro dev`.
  const searchInput = document.querySelector<HTMLInputElement>("[data-search-input]");
  // eslint-disable-next-line @typescript-eslint/no-explicit-any
  let pagefind: any;
  let searchDebounce: ReturnType<typeof setTimeout>;

  async function loadPagefind() {
    try {
      // Built by the `pagefind` CLI's separate output — a variable specifier
      // keeps Rollup from trying to statically resolve/bundle it at build time.
      const pagefindUrl = "/pagefind/pagefind.js";
      // @ts-ignore — not a module TypeScript can resolve.
      pagefind = await import(/* @vite-ignore */ pagefindUrl);
      await pagefind.init();
      if (searchInput) {
        searchInput.disabled = false;
        searchInput.placeholder = "Search writings…";
      }
    } catch {
      if (searchInput) searchInput.placeholder = "Search unavailable (build the site first)";
    }
  }

  if (import.meta.env.DEV) {
    // The pagefind CLI runs after `astro build` (see package.json) — there's
    // no index to fetch in dev, so skip the attempt rather than 404 on it.
    if (searchInput) searchInput.placeholder = "Search unavailable in dev — run a full build";
  } else {
    loadPagefind();
  }

  searchInput?.addEventListener("input", () => {
    clearTimeout(searchDebounce);
    const query = searchInput.value.trim();

    if (!query) {
      state.searchSlugs = null;
      applyFilters();
      return;
    }

    searchDebounce = setTimeout(async () => {
      if (!pagefind) return;
      const { results } = await pagefind.search(query);
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      const entries = await Promise.all(results.map((result: any) => result.data()));
      state.searchSlugs = new Set(
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        entries.map((entry: any) => entry.url.replace(/^\/writings\//, "").replace(/\/$/, "")),
      );
      applyFilters();
    }, 200);
  });
</script>
