---
import { render } from "astro:content";
import ProseLayout from "../../layouts/ProseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import SeriesNav from "../../components/SeriesNav.astro";
import ShareRow from "../../components/ShareRow.astro";
import ViewCount from "../../components/ViewCount.astro";
import ReactionButton from "../../components/ReactionButton.astro";
import CommentSection from "../../components/CommentSection.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import LanguageChip from "../../components/LanguageChip.astro";
import Callout from "../../components/Callout.astro";
import Footnote from "../../components/Footnote.astro";
import {
  getPublishedWritings,
  getSeriesEpisodes,
  getRelatedWritings,
  resolveSeries,
  type WritingEntry,
} from "../../lib/writings";
import { estimateReadingMinutes } from "../../lib/reading-time";
import { formatDate, formatMinutes } from "../../lib/numerals";
import { SITE } from "../../config/site";

export async function getStaticPaths() {
  const writings = await getPublishedWritings();
  return writings.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: WritingEntry;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const series = await resolveSeries(entry);
const seriesEpisodes = series ? await getSeriesEpisodes(series.id) : [];
const related = await getRelatedWritings(entry, 3);
const relatedWithMinutes = related.map((item) => ({
  entry: item,
  readingMinutes: estimateReadingMinutes(item.body ?? "", item.data.lang),
}));

const readingMinutes = estimateReadingMinutes(entry.body ?? "", entry.data.lang);
const canonicalUrl = new URL(`/writings/${entry.id}`, SITE.url).toString();
---

<ProseLayout title={entry.data.title} description={entry.data.description} lang={entry.data.lang} headings={headings}>
  <article data-pagefind-body>
    <header class="mb-10">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <LanguageChip lang={entry.data.lang} />
        {
          series && (
            <a
              href={`/series/${series.id}`}
              class="font-sans text-xs text-text-muted transition-colors duration-fast hover:text-accent"
            >
              {series.data.title}
            </a>
          )
        }
      </div>
      <h1 class="font-serif text-4xl leading-tight text-balance sm:text-5xl" lang={entry.data.lang}>
        {entry.data.title}
      </h1>
      <p class="mt-4 max-w-prose font-serif text-lg text-text-muted" lang={entry.data.lang}>
        {entry.data.description}
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-3 font-sans text-xs text-text-muted">
        <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate, entry.data.lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{formatMinutes(readingMinutes, entry.data.lang)}</span>
        <ViewCount viewKey={`views:${entry.id}`} lang={entry.data.lang} server:defer>
          <Fragment slot="fallback" />
        </ViewCount>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <ReactionButton slug={entry.id} lang={entry.data.lang} />
        <ShareRow url={canonicalUrl} title={entry.data.title} />
      </div>
    </header>

    <div class="prose" data-article-body lang={entry.data.lang}>
      <Content components={{ Callout, Footnote }} />
    </div>

    <div class="mt-16" data-pagefind-ignore>
      <NewsletterForm lang={entry.data.lang} />
    </div>

    {seriesEpisodes.length > 1 && <SeriesNav episodes={seriesEpisodes} current={entry} />}

    {
      relatedWithMinutes.length > 0 && (
        <section class="mt-16 border-t border-border pt-10" data-pagefind-ignore>
          <h2 class="mb-6 font-sans text-sm font-medium uppercase tracking-wide text-text-muted">Related</h2>
          <div class="grid gap-6 sm:grid-cols-3">
            {relatedWithMinutes.map(({ entry: relatedEntry, readingMinutes: relatedMinutes }) => (
              <ArticleCard entry={relatedEntry} readingMinutes={relatedMinutes} />
            ))}
          </div>
        </section>
      )
    }

    <CommentSection pageId={entry.id} pageUrl={canonicalUrl} pageTitle={entry.data.title} />
  </article>
</ProseLayout>

<script is:inline define:vars={{ slug: entry.id }}>
  try {
    const KEY = "opened-writings";
    const opened = new Set(JSON.parse(localStorage.getItem(KEY) ?? "[]"));
    opened.add(slug);
    localStorage.setItem(KEY, JSON.stringify(Array.from(opened)));
  } catch {
    // localStorage unavailable (private browsing, etc.) — series progress just won't track.
  }
</script>
