---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PageHeader from "../components/PageHeader.astro";
import ArticleCard from "../components/ArticleCard.astro";
import VideoCard from "../components/VideoCard.astro";
import { resolveSeries } from "../lib/writings";
import { estimateReadingMinutes } from "../lib/reading-time";
import { FEATURED } from "../config/featured";

const featuredWritings = (
  await Promise.all(
    FEATURED.writings.map(async ({ slug, reason }) => {
      const entry = await getEntry("writings", slug);
      if (!entry) return null;
      return {
        entry,
        reason,
        series: await resolveSeries(entry),
        readingMinutes: estimateReadingMinutes(entry.body ?? "", entry.data.lang),
      };
    }),
  )
).filter((pick) => pick !== null);

const featuredVideo = FEATURED.video ? await getEntry("videos", FEATURED.video.slug) : undefined;
---

<BaseLayout title="Start here" description="A hand-curated path through the site for a first-time reader.">
  <Header />

  <main class="page">
    <PageHeader
      eyebrow="New here?"
      title="Start here"
      lede="A hand-picked path through the site, not the full archive."
    />

    <div class="page-body-narrow">
      {
        featuredWritings.length > 0 && (
          <section class="page-section">
            <h2 class="eyebrow">Read</h2>
            <div class="space-y-8">
              {featuredWritings.map(({ entry, reason, series, readingMinutes }) => (
                <div>
                  <ArticleCard entry={entry} series={series} readingMinutes={readingMinutes} />
                  <p class="reason">{reason}</p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        featuredVideo && (
          <section class="page-section">
            <h2 class="eyebrow">Watch</h2>
            <VideoCard video={featuredVideo} />
            <p class="reason">{FEATURED.video?.reason}</p>
          </section>
        )
      }
    </div>
  </main>
</BaseLayout>

<style>
  .reason {
    margin-top: 0.75rem;
    padding-left: 1rem;
    border-left: 2px solid var(--color-accent);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
