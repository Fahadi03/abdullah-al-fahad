---
import type { Locale } from "../config/site";

// The title block every inner page opens with — the same teal panel, cyan
// display title and glowing bar as the home hero, so no page feels like a
// different site.
interface Props {
  title: string;
  /** Small uppercase label above the title. */
  eyebrow?: string;
  /** One or two sentences under the title. */
  lede?: string;
  lang?: Locale;
  /** "md" for long titles (articles, projects). */
  size?: "lg" | "md";
}

const { title, eyebrow, lede, lang, size = "lg" } = Astro.props;
---

<header class:list={["panel", "page-header", `page-header-${size}`]}>
  <span class="page-ring" aria-hidden="true"></span>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <slot name="top" />
  <h1 class="page-title" lang={lang}>{title}</h1>
  <span class="page-bar" aria-hidden="true"></span>
  {
    lede && (
      <p class="page-lede" lang={lang}>
        {lede}
      </p>
    )
  }
  <slot />
</header>

<style>
  .page-header {
    padding: 2rem 1.5rem;
  }

  @media (min-width: 640px) {
    .page-header {
      padding: 3rem 3rem 2.75rem;
    }
  }

  /* A faint ring with an orbiting dot, echoing the footer */
  .page-ring {
    position: absolute;
    top: -7rem;
    right: -7rem;
    z-index: -1;
    width: 20rem;
    aspect-ratio: 1;
    border: 1.5px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    border-radius: 50%;
    pointer-events: none;
    animation: page-orbit 32s linear infinite;
  }

  .page-ring::after {
    content: "";
    position: absolute;
    top: 50%;
    left: -4px;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 50%;
    background-color: var(--color-accent);
    box-shadow: 0 0 12px 2px var(--color-accent-soft);
  }

  @keyframes page-orbit {
    to {
      transform: rotate(360deg);
    }
  }

  .page-title {
    margin-top: 0.75rem;
    max-width: 22ch;
    font-family: var(--font-display);
    font-size: clamp(3rem, 9vw, 5.5rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: 0.01em;
    color: var(--color-accent);
    text-shadow: 0 0 40px var(--color-accent-soft);
    text-wrap: balance;
  }

  .page-header-md .page-title {
    max-width: 26ch;
    font-size: clamp(2.25rem, 6vw, 3.75rem);
    line-height: 0.95;
  }

  /* Bebas has no Bengali glyphs — Bangla titles use Hind Siliguri, sized for its taller forms. */
  .page-title:lang(bn) {
    font-family: var(--font-display-bn);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .page-bar {
    display: block;
    width: 5rem;
    height: 0.5rem;
    margin-top: 1.25rem;
    border-radius: 999px;
    background-color: var(--color-accent);
    box-shadow: 0 0 14px var(--color-accent-soft);
  }

  .page-lede {
    max-width: 40rem;
    margin-top: 1.25rem;
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .page-lede:lang(bn) {
    font-family: var(--font-sans);
    line-height: 1.9;
  }
</style>
