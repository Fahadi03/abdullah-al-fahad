---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE } from "../config/site";

// Five primary links. Everything else (Start here, Now, Videos, Guestbook) lives in the footer.
const navLinks = [
  { href: "/projects", label: "Projects" },
  { href: "/writings", label: "Writings" },
  { href: SITE.assemblyBase, label: "Assembly" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <span class="brand-name">{SITE.name}</span>
      <span class="brand-sub">Writer | Full-Stack Developer</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary" data-desktop-nav>
      <span class="nav-pill" data-nav-pill aria-hidden="true"></span>
      <ul class="nav-list">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={["nav-link", { "is-active": isActive(link.href) }]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      <ThemeToggle />

      <button
        type="button"
        class="nav-toggle"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menu"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
  </div>

  <div class="header-rule" aria-hidden="true"></div>

  <nav id="mobile-nav" class="mobile-nav" data-mobile-nav hidden aria-label="Primary">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class:list={["mobile-nav-link", { "is-active": isActive(link.href) }]}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-bg) 85%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 0.75rem 1.25rem 0.625rem;
  }

  /* The long cyan rule under the bar, inset to the content width */
  .header-rule {
    max-width: calc(80rem - 2.5rem);
    height: 3px;
    margin-inline: 1.25rem;
    border-radius: 999px;
    background: var(--color-accent);
    box-shadow: 0 0 12px var(--color-accent-soft);
  }

  @media (min-width: 640px) {
    .header-inner {
      padding-inline: 2.5rem;
    }

    .header-rule {
      margin-inline: 2.5rem;
    }
  }

  @media (min-width: 85rem) {
    .header-rule {
      margin-inline: auto;
      max-width: calc(80rem - 5rem);
    }
  }

  /* ---- Brand: condensed name + small role line ---- */
  .brand {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    line-height: 1;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 4.5vw, 2.1rem);
    letter-spacing: 0.02em;
    color: var(--color-accent);
    white-space: nowrap;
    transition: text-shadow var(--duration-slow) var(--ease-editorial);
  }

  .brand:hover .brand-name {
    text-shadow: 0 0 18px var(--color-accent-soft);
  }

  .brand-sub {
    margin-top: 0.2rem;
    padding-top: 0.2rem;
    border-top: 2px solid var(--color-accent);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text);
    white-space: nowrap;
  }

  /* ---- Desktop nav with a sliding cyan pill ---- */
  .desktop-nav {
    display: none;
    position: relative;
    isolation: isolate;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    padding-inline: 0.9rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    white-space: nowrap;
    transition:
      color var(--duration-base) var(--ease-editorial),
      background-color var(--duration-base) var(--ease-editorial);
  }

  .nav-link:hover {
    color: var(--color-accent);
  }

  /* Without JS the active link carries its own pill. */
  .nav-link.is-active {
    background-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .desktop-nav[data-enhanced] .nav-link.is-active {
    background-color: transparent;
    color: var(--color-text);
  }

  .desktop-nav[data-enhanced] .nav-link.is-pilled {
    color: var(--color-accent-ink);
  }

  .nav-pill {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -1;
    height: 2.25rem;
    width: 0;
    border-radius: 999px;
    background-color: var(--color-accent);
    box-shadow: 0 0 18px -2px var(--color-accent-soft);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 420ms var(--ease-editorial),
      width 420ms var(--ease-editorial),
      opacity var(--duration-base) ease;
  }

  .nav-pill.no-anim {
    transition: none;
  }

  /* ---- Actions ---- */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
  }

  .nav-toggle {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid var(--color-accent);
    border-radius: 999px;
    color: var(--color-accent);
  }

  .nav-toggle-bar {
    display: block;
    width: 1.1rem;
    height: 2px;
    border-radius: 2px;
    background-color: currentColor;
    transition:
      transform var(--duration-slow) var(--ease-editorial),
      opacity var(--duration-fast) ease;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* ---- Mobile nav ---- */
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    max-height: calc(100dvh - 5rem);
    overflow-y: auto;
    padding: 1rem 1.25rem 1.25rem;
    animation: mobile-nav-in var(--duration-slow) var(--ease-editorial);
  }

  @keyframes mobile-nav-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    min-height: 46px;
    padding-inline: 1.25rem;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
    transition:
      background-color var(--duration-base) var(--ease-editorial),
      color var(--duration-base) var(--ease-editorial);
  }

  .mobile-nav-link:hover {
    background-color: var(--color-bg-raised);
    color: var(--color-accent);
  }

  .mobile-nav-link.is-active {
    background-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  /* Narrow phones: tighten spacing so the name stays on one line. */
  @media (max-width: 400px) {
    .header-inner {
      gap: 0.5rem;
    }

    .header-actions {
      gap: 0.375rem;
    }

    /* Too narrow for a readable role line — the name carries the brand alone. */
    .brand-sub {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
    }

    .nav-toggle,
    .mobile-nav {
      display: none;
    }
  }
</style>

<script>
  // ---- Mobile menu ----
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");

  function setMenu(open: boolean) {
    toggle?.setAttribute("aria-expanded", String(open));
    if (mobileNav) mobileNav.hidden = !open;
  }

  toggle?.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setMenu(false);
      toggle.focus();
    }
  });

  // ---- Sliding pill ----
  const nav = document.querySelector<HTMLElement>("[data-desktop-nav]");
  const pill = nav?.querySelector<HTMLElement>("[data-nav-pill]");

  if (nav && pill) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>(".nav-link"));
    const active = links.find((link) => link.classList.contains("is-active"));
    nav.dataset.enhanced = "";

    const moveTo = (target: HTMLElement | undefined) => {
      for (const link of links) link.classList.toggle("is-pilled", link === target);
      if (!target) {
        pill.style.opacity = "0";
        return;
      }
      const navBox = nav.getBoundingClientRect();
      const box = target.getBoundingClientRect();
      pill.style.width = `${box.width}px`;
      pill.style.transform = `translate(${box.left - navBox.left}px, ${box.top - navBox.top}px)`;
      pill.style.opacity = "1";
    };

    const snapToActive = () => {
      pill.classList.add("no-anim");
      moveTo(active);
      requestAnimationFrame(() => pill.classList.remove("no-anim"));
    };

    snapToActive();
    document.fonts?.ready.then(snapToActive);
    window.addEventListener("resize", snapToActive);

    for (const link of links) {
      link.addEventListener("mouseenter", () => moveTo(link));
      link.addEventListener("focus", () => moveTo(link));
    }
    nav.addEventListener("mouseleave", () => moveTo(active));
    nav.addEventListener("focusout", (event) => {
      if (!nav.contains(event.relatedTarget as Node)) moveTo(active);
    });
  }
</script>
