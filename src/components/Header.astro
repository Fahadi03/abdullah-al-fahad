---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE } from "../config/site";

const navLinks = [
  { href: "/start", label: "Start here" },
  { href: "/writings", label: "Writings" },
  { href: "/videos", label: "Videos" },
  { href: SITE.assemblyBase, label: "Assembly" },
  { href: "/projects", label: "Projects" },
  { href: "/about", label: "About" },
  { href: "/now", label: "Now" },
  { href: "/contact", label: "Contact" },
  { href: "/guestbook", label: "Guestbook" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label={`${SITE.name} — home`}>
      <span class="brand-mark" aria-hidden="true">AF</span>
      <span class="brand-name">{SITE.name}</span>
    </a>

    <nav class="desktop-nav" aria-label="Primary" data-desktop-nav>
      <ul class="nav-list">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={["nav-link", { "is-active": isActive(link.href) }]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <span class="nav-indicator" data-nav-indicator aria-hidden="true"><i></i></span>
    </nav>

    <div class="header-actions">
      <ThemeToggle />

      <button
        type="button"
        class="nav-toggle"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menu"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" data-mobile-nav hidden aria-label="Primary">
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class:list={["mobile-nav-link", { "is-active": isActive(link.href) }]}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--color-border);
  }

  /* Faint glowing rule under the bar */
  .site-header::after {
    content: "";
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: -1px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    opacity: 0.5;
    pointer-events: none;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 80rem;
    margin-inline: auto;
    padding: 0.75rem 1.25rem;
  }

  @media (min-width: 640px) {
    .header-inner {
      padding-inline: 2.5rem;
    }
  }

  /* ---- Brand ---- */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-width: 0;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.5rem;
    clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
    background: linear-gradient(160deg, var(--color-accent), color-mix(in srgb, var(--color-accent) 60%, var(--color-bg)));
    color: var(--color-accent-ink);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    transition: transform var(--duration-slow) var(--ease-editorial);
  }

  .brand:hover .brand-mark {
    transform: scale(1.08);
  }

  .brand-name {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---- Desktop nav with sliding glow indicator ---- */
  .desktop-nav {
    display: none;
    position: relative;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    height: 2.5rem;
    padding-inline: 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    white-space: nowrap;
    transition: color var(--duration-base) var(--ease-editorial);
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link.is-active {
    color: var(--color-text);
  }

  .nav-indicator {
    position: absolute;
    left: 0;
    bottom: -0.2rem;
    width: 0;
    height: 2px;
    opacity: 0;
    pointer-events: none;
    transition:
      transform 450ms var(--ease-editorial),
      width 450ms var(--ease-editorial),
      opacity var(--duration-base) ease;
  }

  .nav-indicator.no-anim {
    transition: none;
  }

  .nav-indicator i {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, var(--color-accent) 25%, var(--color-text) 50%, var(--color-accent) 75%, transparent);
    box-shadow:
      0 0 8px 1px var(--color-accent),
      0 0 22px 2px var(--color-accent-soft);
  }

  .nav-indicator.is-moving i {
    animation: nav-streak 450ms var(--ease-editorial);
  }

  @keyframes nav-streak {
    0% {
      transform: scaleX(1);
    }
    35% {
      transform: scaleX(1.9);
      filter: blur(1px);
    }
    100% {
      transform: scaleX(1);
    }
  }

  /* ---- Actions ---- */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
  }

  .nav-toggle {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background-color: var(--color-bg-raised);
    color: var(--color-text);
  }

  .nav-toggle-bar {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    border-radius: 2px;
    background-color: currentColor;
    transition:
      transform var(--duration-slow) var(--ease-editorial),
      opacity var(--duration-fast) ease;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }

  .nav-toggle[aria-expanded="true"] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  /* ---- Mobile nav ---- */
  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-height: calc(100dvh - 4.5rem);
    overflow-y: auto;
    padding: 0.75rem 1.25rem 1.25rem;
    border-top: 1px solid var(--color-border);
    animation: mobile-nav-in var(--duration-slow) var(--ease-editorial);
  }

  @keyframes mobile-nav-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  .mobile-nav-link {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 48px;
    padding-inline: 1rem;
    border-radius: var(--radius-md);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text-muted);
    transition:
      background-color var(--duration-base) var(--ease-editorial),
      color var(--duration-base) var(--ease-editorial);
  }

  .mobile-nav-link:hover {
    background-color: var(--color-bg-raised);
    color: var(--color-text);
  }

  .mobile-nav-link.is-active {
    background-color: var(--color-bg-raised);
    color: var(--color-text);
  }

  .mobile-nav-link.is-active::before {
    content: "";
    position: absolute;
    left: 0;
    top: 25%;
    bottom: 25%;
    width: 3px;
    border-radius: 999px;
    background-color: var(--color-accent);
    box-shadow: 0 0 10px var(--color-accent);
  }

  /* Narrow phones: let the name wrap onto two lines instead of truncating. */
  @media (max-width: 479px) {
    .header-inner {
      gap: 0.625rem;
    }

    .brand-name {
      white-space: normal;
      font-size: 0.875rem;
      line-height: 1.15;
    }

    .header-actions {
      gap: 0.5rem;
    }
  }

  @media (min-width: 1024px) {
    .desktop-nav {
      display: block;
    }

    .nav-toggle,
    .mobile-nav {
      display: none;
    }

    /* Nine links are tight until wide screens — show just the hexagon mark. */
    .brand-name {
      display: none;
    }
  }

  @media (min-width: 1240px) {
    .brand-name {
      display: inline;
    }
  }
</style>

<script>
  // ---- Mobile menu ----
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const mobileNav = document.querySelector<HTMLElement>("[data-mobile-nav]");

  function setMenu(open: boolean) {
    toggle?.setAttribute("aria-expanded", String(open));
    if (mobileNav) mobileNav.hidden = !open;
  }

  toggle?.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setMenu(false);
      toggle.focus();
    }
  });

  // ---- Sliding glow indicator ----
  const nav = document.querySelector<HTMLElement>("[data-desktop-nav]");
  const indicator = nav?.querySelector<HTMLElement>("[data-nav-indicator]");

  if (nav && indicator) {
    const links = Array.from(nav.querySelectorAll<HTMLAnchorElement>(".nav-link"));
    const active = links.find((link) => link.classList.contains("is-active"));

    const moveTo = (target: HTMLElement | undefined, animate: boolean) => {
      if (!target) {
        indicator.style.opacity = "0";
        return;
      }
      const navBox = nav.getBoundingClientRect();
      const box = target.getBoundingClientRect();
      const width = box.width * 0.7;
      indicator.style.width = `${width}px`;
      indicator.style.transform = `translateX(${box.left - navBox.left + (box.width - width) / 2}px)`;
      indicator.style.opacity = "1";
      if (animate) {
        indicator.classList.remove("is-moving");
        void indicator.offsetWidth; // restart the streak animation
        indicator.classList.add("is-moving");
      }
    };

    const snapToActive = () => {
      indicator.classList.add("no-anim");
      moveTo(active, false);
      requestAnimationFrame(() => indicator.classList.remove("no-anim"));
    };

    snapToActive();
    document.fonts?.ready.then(snapToActive);
    window.addEventListener("resize", snapToActive);

    for (const link of links) {
      link.addEventListener("mouseenter", () => moveTo(link, true));
      link.addEventListener("focus", () => moveTo(link, true));
    }
    nav.addEventListener("mouseleave", () => moveTo(active, true));
    nav.addEventListener("focusout", (event) => {
      if (!nav.contains(event.relatedTarget as Node)) moveTo(active, true);
    });
  }
</script>
