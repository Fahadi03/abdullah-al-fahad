---
import ThemeToggle from "./ThemeToggle.astro";
import { SITE } from "../config/site";
---

<header class="flex items-center justify-between border-b border-border px-6 py-4 sm:px-10">
  <a href="/" class="font-sans text-sm font-medium tracking-wide">{SITE.name}</a>
  <nav class="flex items-center gap-6">
    <a
      href="/writings"
      class="font-sans text-sm text-text-muted transition-colors duration-fast hover:text-text"
    >
      Writings
    </a>
    <ThemeToggle />
  </nav>
</header>
