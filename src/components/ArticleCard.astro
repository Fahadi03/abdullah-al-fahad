---
import type { CollectionEntry } from "astro:content";
import LanguageChip from "./LanguageChip.astro";
import { formatDate, formatMinutes } from "../lib/numerals";

interface Props {
  entry: CollectionEntry<"writings">;
  series?: CollectionEntry<"series">;
  readingMinutes: number;
}

const { entry, series, readingMinutes } = Astro.props;
const { title, description, lang, pubDate } = entry.data;
---

<a
  href={`/writings/${entry.id}`}
  class="article-card group block rounded-md border border-border p-6 transition-colors duration-fast hover:border-accent"
  data-slug={entry.id}
  data-lang={lang}
  data-tags={entry.data.tags.join(",")}
  data-series={series?.id ?? ""}
>
  <div class="mb-3 flex flex-wrap items-center gap-2">
    <LanguageChip lang={lang} />
    {series && <span class="font-sans text-xs text-text-muted">{series.data.title}</span>}
  </div>
  <h3
    class="font-serif text-2xl leading-snug text-balance transition-colors duration-fast group-hover:text-accent"
    lang={lang}
  >
    {title}
  </h3>
  <p class="mt-2 line-clamp-2 font-serif text-text-muted" lang={lang}>{description}</p>
  <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 font-sans text-xs text-text-muted">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
    <span aria-hidden="true">·</span>
    <span>{formatMinutes(readingMinutes, lang)}</span>
    <span data-view-count-slug={entry.id} data-view-count-lang={lang} hidden>
      <span aria-hidden="true">·</span> <span data-view-count-text />
    </span>
  </div>
</a>

<script>
  import { formatCount } from "../lib/numerals";

  const nodes = Array.from(document.querySelectorAll<HTMLElement>("[data-view-count-slug]"));
  const slugs = [...new Set(nodes.map((node) => node.dataset.viewCountSlug).filter((s): s is string => !!s))];

  if (slugs.length > 0) {
    fetch(`/api/views?slugs=${encodeURIComponent(slugs.join(","))}`)
      .then((res) => res.json())
      .then((counts: Record<string, number>) => {
        for (const node of nodes) {
          const slug = node.dataset.viewCountSlug;
          const count = slug ? counts[slug] : undefined;
          if (!count) continue;
          const lang = node.dataset.viewCountLang === "bn" ? "bn" : "en";
          const textEl = node.querySelector("[data-view-count-text]");
          if (textEl) {
            textEl.textContent = lang === "bn" ? `${formatCount(count, "bn")} বার দেখা` : `${formatCount(count, "en")} views`;
            node.hidden = false;
          }
        }
      })
      .catch(() => {
        // Listing-card view counts are decorative — silently leave them hidden.
      });
  }
</script>
