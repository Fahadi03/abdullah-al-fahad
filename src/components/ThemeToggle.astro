---
// Three-way theme switch: Light / Dark / System. Vanilla — no hydration.
// "System" clears the stored choice so the page follows prefers-color-scheme.
const options = [
  { value: "light", label: "Light theme" },
  { value: "dark", label: "Dark theme" },
  { value: "system", label: "Use system theme" },
] as const;
---

<div class="theme-switch" role="group" aria-label="Color theme" data-theme-switch>
  {
    options.map((option) => (
      <button
        type="button"
        class="theme-option"
        data-theme-option={option.value}
        aria-pressed="false"
        aria-label={option.label}
        title={option.label}
      >
        {option.value === "light" && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
        )}
        {option.value === "dark" && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round">
            <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" />
          </svg>
        )}
        {option.value === "system" && (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="12" rx="2" />
            <path d="M8 20h8M12 16v4" />
          </svg>
        )}
      </button>
    ))
  }
</div>

<style>
  .theme-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.1875rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background-color: var(--color-bg-raised);
  }

  .theme-option {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.125rem;
    height: 2.125rem;
    border-radius: 999px;
    color: var(--color-text-muted);
    transition:
      background-color var(--duration-base) var(--ease-editorial),
      color var(--duration-base) var(--ease-editorial),
      box-shadow var(--duration-base) var(--ease-editorial);
  }

  .theme-option svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .theme-option:hover {
    color: var(--color-text);
  }

  .theme-option[aria-pressed="true"] {
    background-color: var(--color-accent);
    color: var(--color-accent-ink);
    box-shadow: 0 0 14px -2px var(--color-accent-soft);
  }
</style>

<script>
  type Mode = "light" | "dark" | "system";

  const STORAGE_KEY = "theme";
  const root = document.documentElement;

  function storedMode(): Mode {
    try {
      const stored = localStorage.getItem(STORAGE_KEY);
      if (stored === "light" || stored === "dark") return stored;
    } catch {
      // Storage blocked (private mode) — fall back to System.
    }
    return "system";
  }

  function paint(mode: Mode) {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-option]").forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.themeOption === mode));
    });
  }

  function apply(mode: Mode) {
    try {
      if (mode === "system") localStorage.removeItem(STORAGE_KEY);
      else localStorage.setItem(STORAGE_KEY, mode);
    } catch {
      // Choice just won't persist across reloads.
    }
    if (mode === "system") delete root.dataset.theme;
    else root.dataset.theme = mode;
    paint(mode);
  }

  paint(storedMode());

  document.querySelectorAll<HTMLButtonElement>("[data-theme-option]").forEach((button) => {
    button.addEventListener("click", () => apply(button.dataset.themeOption as Mode));
  });
</script>
